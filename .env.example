# Copy to .env and fill in. .env is gitignored.
# Viper maps DATABASE_HOST -> database.host (dots -> underscores).
# Any var here overrides config.json.

# ─── Postgres (Supabase) ───────────────────────────────────────────
# From Supabase: Project Settings -> Database -> Connection string (URI).
# Use the DIRECT connection (port 5432), not the pooler, for migrations + asynq.
DATABASE_HOST=db.XXXXXX.supabase.co
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
DATABASE_NAME=postgres
DATABASE_SSLMODE=require

# ─── Cloudflare R2 ─────────────────────────────────────────────────
# Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Create.
# Scope: Object Read & Write on the bucket below.
R2_ENDPOINT=https://XXXXXXXX.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY=changeme
R2_SECRET_KEY=changeme
R2_BUCKET=idx-mcp

# ─── MCP auth ──────────────────────────────────────────────────────
# Generate a strong random token; Claude Desktop/Ollama config carries it.
MCP_TOKEN=changeme

# ─── Redis (external managed; local docker-compose for dev) ──────────
# Prod: Redis Cloud free tier (30 MB, 30 conns, unmetered commands).
# Local dev: leave unset -> config.json default localhost:6379 (docker-compose redis).
# REDIS_ADDRESS=redis-XXXX.redis-cloud.com:6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=changeme
# REDIS_DB=0
# REDIS_TLS=true   # only if the provider requires encryption-in-transit

# ─── FlareSolverr (idx.co.id Cloudflare bypass) ─────────────────────
# Wave-1 ingestion (stock summary, announcements) routes through a
# self-hosted FlareSolverr when IDX_FETCH_MODE=flaresolverr.
# IDX_FETCH_MODE=direct   # direct (default) | flaresolverr
# FLARESOLVERR_BASE_URL=http://<host>:<port>   # Caddy-protected root URL (client appends /v1)
# FLARESOLVERR_TOKEN=changeme                   # sent as Authorization: Bearer
# FLARESOLVERR_TIMEOUT=15s                # per-proxy budget
# FLARESOLVERR_PROXIES=https://...        # HTTPS URL to a JSON array of proxy URLs
# FLARESOLVERR_PROXIES_TTL=1h
# FLARESOLVERR_DEAD_RETRY_AFTER=6h
# FLARESOLVERR_WAKE_TIMEOUT=120s
# FLARESOLVERR_SESSION_TTL_MINUTES=30