# Copy to .env and fill in. .env is gitignored.
# Viper maps DATABASE_HOST -> database.host (dots -> underscores).
# Any var here overrides config.json.

# ─── Postgres (Supabase) ───────────────────────────────────────────
# From Supabase: Project Settings -> Database -> Connection string (URI).
# Use the DIRECT connection (port 5432), not the pooler, for migrations + asynq.
DATABASE_HOST=db.XXXXXX.supabase.co
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
DATABASE_NAME=postgres
DATABASE_SSLMODE=require

# ─── Cloudflare R2 ─────────────────────────────────────────────────
# Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Create.
# Scope: Object Read & Write on the bucket below.
R2_ENDPOINT=https://XXXXXXXX.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY=changeme
R2_SECRET_KEY=changeme
R2_BUCKET=idx-mcp

# ─── MCP auth ──────────────────────────────────────────────────────
# Generate a strong random token; Claude Desktop/Ollama config carries it.
MCP_TOKEN=changeme

# ─── Redis (local docker for now; SnapDeploy bundles in-container later) ──
# REDIS_ADDRESS=localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0